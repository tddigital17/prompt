{"file":"_id_-DBZlYUnG.js","mappings":";;;;;;;;;;;;;;;;;;;;;;AAsFA,UAAM,QAAQ,SAAA;AACd,UAAM,WAAW,kBAAA;AACjB,UAAM,EAAE,cAA+B,WAAA,IAAe,SAAA;AAEtD,UAAM,EAAE,MAAM,QAAQ,QAAA,KAAY,CAAA,QAAA,SAAA,IAAAA,iBAAA,YAAM,aAAa,UAAU,MAAM,OAAO,EAAE,IAAI,YAAY;AAC5F,YAAM,EAAE,KAAA,IAAS,MAAM,SACpB,KAAK,SAAS,EACd,OAAO,qBAAqB,EAC5B,GAAG,MAAM,MAAM,OAAO,EAAE,EACxB,OAAA;AACH,aAAO;AAAA,IACT,CAAC,CAAA;;;;;;UAhGYC,MAAA,MAAA,GAAM;AAAE,cAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,4CAAwC,MAAA,CAAA,CAAA,GAAA;;;AASf,cAAAC,mBAAA,qBAAA,EAAA,IAAG,OAAG;AAAA,2BAAhB,CAAgC,GAAAC,QAAAC,UAAA,aAAA;;;;;gCAAf,MAAI;AAAA,cAAA;AAAA;;;;wEACXL,MAAA,MAAA,EAAO,YAAY,IAAI,6CAIrCM,eAAAN,MAAA,MAAA,EAAO,KAAK,oFAKnCO,cAAA,OAAG,iCAAmCP,MAAA,YAAA,EAAaA,MAAA,MAAA,EAAO,WAAW,CAAA,EAAA,gpBAiBnC,EAAA,eAAA,YAAA,eAAA,qCAA8E,MAAIM,eAAAN,MAAA,MAAA,EAAO,WAAW,6JAOxGM,eAAAN,MAAA,MAAA,EAAO,eAAW,+BAAA,0FAM7B,EAAA,OAAA,QAAA,CAAmB,8EAEjCO,cAAA,OAAG,8BAAgCP,MAAA,YAAA,EAAaA,MAAA,MAAA,EAAO,WAAW,CAAA,gBAAA,uJAEpCA,MAAA,UAAA,EAAWA,MAAA,MAAA,EAAO,UAAU,CAAA,qGAE3DA,MAAA,MAAA,EAAO,YAAY,IAAI;AAElB,cAAAG,mBAAA,qBAAA,EAAA,UAAS,aAAS,MAAA,OAAA,CAAA;;AAGpB,cAAAA,mBAAA,qBAAA,EAAA,UAAS,YAAQ,MAAA,OAAA,CAAA;;;;iBAmBrBH,MAAA,OAAA,GAAO;AAAE,cAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,6DAAyD,MAAA,CAAA,CAAA,sEAAA;AAAA;;;;;;;;;;;;","names":["_withAsyncContext","_unref","_ssrRenderAttrs","_mergeProps","_ssrRenderComponent","_push","_parent","_ssrInterpolate","_ssrRenderAttr"],"sources":["../../../../pages/detail/[id].vue"],"sourcesContent":["<template>\r\n  <div v-if=\"prompt\" class=\"bg-light min-vh-100 d-flex flex-column\">\r\n    <Navbar />\r\n    \r\n    <div class=\"container py-5\">\r\n      <div class=\"row g-4\">\r\n        <!-- Main Content -->\r\n        <div class=\"col-lg-8\">\r\n          <nav aria-label=\"breadcrumb\" class=\"mb-4\">\r\n            <ol class=\"breadcrumb\">\r\n              <li class=\"breadcrumb-item\"><NuxtLink to=\"/\">Home</NuxtLink></li>\r\n              <li class=\"breadcrumb-item active\">{{ prompt.categories?.name }}</li>\r\n            </ol>\r\n          </nav>\r\n\r\n          <h1 class=\"fw-bold mb-4\">{{ prompt.title }}</h1>\r\n          \r\n          <!-- Video Player -->\r\n          <div class=\"ratio ratio-16x9 rounded-4 overflow-hidden shadow mb-5\">\r\n            <iframe \r\n              :src=\"`https://www.youtube.com/embed/${getYouTubeID(prompt.youtube_url)}`\" \r\n              title=\"YouTube video player\" \r\n              frameborder=\"0\" \r\n              allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" \r\n              allowfullscreen\r\n            ></iframe>\r\n          </div>\r\n\r\n          <!-- Prompt Section -->\r\n          <div class=\"card border-0 rounded-4 shadow-sm overflow-hidden mb-5\">\r\n            <div class=\"card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center\">\r\n              <h5 class=\"mb-0 fw-bold\"><i class=\"bi bi-terminal me-2 text-primary\"></i>AI Prompt</h5>\r\n              <button @click=\"copyPrompt\" class=\"btn btn-primary btn-sm rounded-pill px-3\">\r\n                <i class=\"bi bi-clipboard me-2\"></i>Salin Prompt\r\n              </button>\r\n            </div>\r\n            <div class=\"card-body bg-dark\">\r\n              <pre class=\"text-success p-3 mb-0\" style=\"white-space: pre-wrap; font-family: 'Courier New', Courier, monospace;\">{{ prompt.prompt_text }}</pre>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Description -->\r\n          <div class=\"card border-0 rounded-4 shadow-sm p-4 mb-4\">\r\n            <h5 class=\"fw-bold mb-3\">Tentang Project Ini</h5>\r\n            <div class=\"text-muted lh-lg\">{{ prompt.description || 'Tidak ada deskripsi tambahan.' }}</div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Sidebar -->\r\n        <div class=\"col-lg-4\">\r\n          <div class=\"sticky-top\" style=\"top: 100px;\">\r\n            <div class=\"card border-0 rounded-4 shadow-sm p-4 mb-4 text-center\">\r\n              <img :src=\"`https://img.youtube.com/vi/${getYouTubeID(prompt.youtube_url)}/mqdefault.jpg`\" class=\"rounded-3 mb-3 w-100 shadow-sm\" alt=\"Small Thumb\">\r\n              <h6 class=\"fw-bold mb-1\">Dibuat pada</h6>\r\n              <p class=\"text-muted small mb-3\">{{ formatDate(prompt.created_at) }}</p>\r\n              <div class=\"badge bg-primary-subtle text-primary rounded-pill py-2 px-3 mb-4\">\r\n                {{ prompt.categories?.name }}\r\n              </div>\r\n              <AdBanner position=\"sidebar\" />\r\n            </div>\r\n            \r\n            <AdBanner position=\"bottom\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <Footer />\r\n    \r\n    <!-- Success Toast -->\r\n    <div class=\"toast-container position-fixed bottom-0 end-0 p-3\">\r\n      <div id=\"copyToastDetail\" class=\"toast align-items-center text-white bg-success border-0\" role=\"alert\">\r\n        <div class=\"d-flex\">\r\n          <div class=\"toast-body\"><i class=\"bi bi-check-circle me-2\"></i>Prompt berhasil disalin!</div>\r\n          <button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" data-bs-dismiss=\"toast\"></button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  \r\n  <div v-else-if=\"pending\" class=\"vh-100 d-flex justify-content-center align-items-center\">\r\n    <div class=\"spinner-border text-primary\" role=\"status\"></div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nconst route = useRoute();\r\nconst supabase = useSupabaseClient();\r\nconst { getYouTubeID, copyToClipboard, formatDate } = useUtils();\r\n\r\nconst { data: prompt, pending } = await useAsyncData(`prompt-${route.params.id}`, async () => {\r\n  const { data } = await supabase\r\n    .from('prompts')\r\n    .select('*, categories(name)')\r\n    .eq('id', route.params.id)\r\n    .single();\r\n  return data;\r\n});\r\n\r\nconst copyPrompt = async () => {\r\n  const success = await copyToClipboard(prompt.value.prompt_text);\r\n  if (success) {\r\n    const toastEl = document.getElementById('copyToastDetail');\r\n    const toast = new bootstrap.Toast(toastEl);\r\n    toast.show();\r\n  }\r\n};\r\n</script>\r\n"],"version":3}