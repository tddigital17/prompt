{"file":"login-INj0RfZD.js","mappings":";;;;;;;;;;;;;;;;;;AA8Ce,sBAAiB;AAChC,UAAM,OAAO,gBAAe;AAC5B,UAAM,QAAQ,IAAI,EAAE;AACpB,UAAM,WAAW,IAAI,EAAE;AACvB,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,QAAQ,IAAI,IAAI;AAEtB,gBAAY,MAAM;AAChB,UAAI,KAAK,MAAO,YAAW,QAAQ;AAAA,IACrC,CAAC;;;mBAtDMA,eAAAC,WAAA,EAAA,OAAM,4EAA2E,GAAA,MAAA,CAAA,oFAC3B,EAAA,aAAA,QAAA,CAAyB;;QAEpE,IAAG;AAAA,QAAI,OAAM;AAAA;yBAAvB,CAGW,GAAAC,QAAAC,UAAA,aAAA;;;;;cAFTC,YAA4E,QAAA,EAAtE,OAAM,8BAA6B,GAAA;AAAA,gBAACA,YAA2B,KAAA,EAAxB,OAAM,cAAa,CAAA;AAAA;cAChEA,YAAmD,MAAA,EAA/C,OAAM,yBAAwB,GAAC,aAAW;AAAA;;;;;qXAU5BC,MAAA,KAAA,CAAK,iYAQLA,MAAA,QAAA,CAAQ;UAIjBA,MAAA,KAAA,GAAK;kJACyCA,MAAA,KAAA,CAAK,CAAA,QAAA;AAAA;;;sHAG+BA,MAAA,OAAA,CAAO,IAAA,cAAA,EAAA,GAAA;UACtFA,MAAA,OAAA,GAAO;;;;;;;QAIX,IAAG;AAAA,QAAI,OAAM;AAAA;yBAAvB,CAEW,GAAAH,QAAAC,UAAA,aAAA;;;;;cADTC,YAAqC,KAAA,EAAlC,OAAM,wBAAuB,CAAA;AAAA,8BAAK,qBACvC;AAAA;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_push","_parent","_createVNode","_unref"],"sources":["../../../../pages/admin/login.vue"],"sourcesContent":["<template>\r\n  <div class=\"min-vh-100 d-flex align-items-center justify-content-center bg-light px-3\">\r\n    <div class=\"card border-0 rounded-4 shadow-lg p-4 w-100\" style=\"max-width: 400px;\">\r\n      <div class=\"text-center mb-4\">\r\n        <NuxtLink to=\"/\" class=\"text-decoration-none\">\r\n          <span class=\"brand-icon brand-icon-login\"><i class=\"bi bi-stars\"></i></span>\r\n          <h3 class=\"fw-bold text-dark mt-3\">Admin Login</h3>\r\n        </NuxtLink>\r\n        <p class=\"text-muted small\">Khusus pengelola platform</p>\r\n      </div>\r\n      \r\n      <form @submit.prevent=\"handleLogin\">\r\n        <div class=\"mb-3\">\r\n          <label class=\"form-label small fw-bold text-uppercase text-muted\">Email Address</label>\r\n          <div class=\"input-group border rounded-3 overflow-hidden\">\r\n            <span class=\"input-group-text bg-white border-0\"><i class=\"bi bi-envelope text-muted\"></i></span>\r\n            <input v-model=\"email\" type=\"email\" class=\"form-control border-0 py-2\" placeholder=\"admin@domain.com\" required>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"mb-4\">\r\n          <label class=\"form-label small fw-bold text-uppercase text-muted\">Password</label>\r\n          <div class=\"input-group border rounded-3 overflow-hidden\">\r\n            <span class=\"input-group-text bg-white border-0\"><i class=\"bi bi-lock text-muted\"></i></span>\r\n            <input v-model=\"password\" type=\"password\" class=\"form-control border-0 py-2\" placeholder=\"••••••••\" required>\r\n          </div>\r\n        </div>\r\n        \r\n        <div v-if=\"error\" class=\"alert alert-danger border-0 rounded-3 small py-2\">\r\n          <i class=\"bi bi-exclamation-triangle-fill me-2\"></i>{{ error }}\r\n        </div>\r\n        \r\n        <button type=\"submit\" class=\"btn btn-primary w-100 py-2 rounded-3 shadow-sm mb-3\" :disabled=\"loading\">\r\n          <span v-if=\"loading\" class=\"spinner-border spinner-border-sm me-2\"></span>\r\n          Masuk ke Dashboard\r\n        </button>\r\n        \r\n        <NuxtLink to=\"/\" class=\"btn btn-link w-100 text-muted small text-decoration-none\">\r\n          <i class=\"bi bi-arrow-left me-1\"></i>Kembali ke Beranda\r\n        </NuxtLink>\r\n      </form>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nconst client = useSupabaseClient();\r\nconst user = useSupabaseUser();\r\nconst email = ref('');\r\nconst password = ref('');\r\nconst loading = ref(false);\r\nconst error = ref(null);\r\n\r\nwatchEffect(() => {\r\n  if (user.value) navigateTo('/admin');\r\n});\r\n\r\nconst handleLogin = async () => {\r\n  loading.value = true;\r\n  error.value = null;\r\n  \r\n  const { error: err } = await client.auth.signInWithPassword({\r\n    email: email.value,\r\n    password: password.value\r\n  });\r\n  \r\n  if (err) {\r\n    error.value = err.message || \"Email atau password salah.\";\r\n    loading.value = false;\r\n  }\r\n};\r\n</script>\r\n"],"version":3}