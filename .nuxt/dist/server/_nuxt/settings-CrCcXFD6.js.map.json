{"file":"settings-CrCcXFD6.js","mappings":";;;;;;;;;;;;;;;;;;;AAgDiB,sBAAiB;AAClC,UAAM,SAAS,IAAI,IAAI;AAEvB,UAAM,YAAY;AAAA,MAChB,EAAE,IAAI,gBAAgB,OAAO,qBAAoB;AAAA,MACjD,EAAE,IAAI,oBAAoB,OAAO,uBAAsB;AAAA,MACvD,EAAE,IAAI,mBAAmB,OAAO,sBAAqB;AAAA,IACvD;AAEA,UAAMA,YAAW,SAAS;AAAA,MACxB,cAAc;AAAA,MACd,kBAAkB;AAAA,MAClB,iBAAiB;AAAA,IACnB,CAAC;;;AA5DM,YAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,gCAA4B,MAAA,CAAA,CAAA,mBAAA;;;AAYdC,oBAAA,YAAP,QAAG;kgBAO+BC,eAAA,IAAI,KAAK,4WAOpCC,MAAAL,SAAA,EAAS,IAAI,EAAE,CAAA,4GAM8EK,MAAA,MAAA,MAAW,IAAI,EAAE,IAAA,cAAA;YAChHA,MAAA,MAAA,MAAW,IAAI,IAAE;;;;;;;;;;;;;;;;;;","names":["settings","_ssrRenderAttrs","_mergeProps","_ssrRenderList","_ssrInterpolate","_unref"],"sources":["../../../../pages/admin/settings.vue"],"sourcesContent":["<template>\r\n  <div class=\"d-flex min-vh-100 bg-light\">\r\n    <AdminSidebar />\r\n\r\n    <div class=\"flex-grow-1 main-admin-content p-3 p-md-4 p-xl-5\">\r\n      <div class=\"d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom\">\r\n        <div>\r\n          <h3 class=\"fw-bold text-dark mb-1\">Pengaturan Iklan Adsterra</h3>\r\n          <p class=\"text-muted small mb-0\">Kelola script iklan untuk posisi leaderboard, sidebar, dan footer.</p>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"row g-4\">\r\n        <div v-for=\"pos in positions\" :key=\"pos.id\" class=\"col-md-6 col-xl-4\">\r\n          <div class=\"card border-0 rounded-4 shadow-sm h-100 overflow-hidden\">\r\n            <div class=\"card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between\">\r\n              <div class=\"d-flex align-items-center\">\r\n                <div class=\"icon-box bg-primary-subtle text-primary rounded-3 p-2 me-2\">\r\n                  <i class=\"bi bi-badge-ad\"></i>\r\n                </div>\r\n                <h6 class=\"fw-bold mb-0 text-dark\">{{ pos.label }}</h6>\r\n              </div>\r\n            </div>\r\n            <div class=\"card-body p-4\">\r\n              <div class=\"mb-3\">\r\n                <label class=\"form-label small text-muted fw-bold text-uppercase\">Script Iklan (HTML/JS)</label>\r\n                <textarea \r\n                  v-model=\"settings[pos.id]\" \r\n                  class=\"form-control rounded-3 font-monospace small\" \r\n                  rows=\"12\" \r\n                  placeholder=\"Paste script tag Adsterra di sini...\"\r\n                ></textarea>\r\n              </div>\r\n              <button @click=\"saveSetting(pos.id)\" class=\"btn btn-primary w-100 rounded-pill py-2 shadow-sm\" :disabled=\"saving === pos.id\">\r\n                <i v-if=\"saving === pos.id\" class=\"spinner-border spinner-border-sm me-2\"></i>\r\n                Simpan Perubahan\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\ndefinePageMeta({ middleware: 'auth' });\r\n\r\nconst supabase = useSupabaseClient();\r\nconst saving = ref(null);\r\n\r\nconst positions = [\r\n  { id: 'adsterra_top', label: 'Atas (Leaderboard)' },\r\n  { id: 'adsterra_sidebar', label: 'Bilah Sisi (Sidebar)' },\r\n  { id: 'adsterra_bottom', label: 'Bawah (Footer Area)' }\r\n];\r\n\r\nconst settings = reactive({\r\n  adsterra_top: '',\r\n  adsterra_sidebar: '',\r\n  adsterra_bottom: ''\r\n});\r\n\r\nonMounted(async () => {\r\n  const { data } = await supabase.from('settings').select('*');\r\n  data?.forEach(s => {\r\n    if (Object.prototype.hasOwnProperty.call(settings, s.id)) settings[s.id] = s.content || '';\r\n  });\r\n});\r\n\r\nconst saveSetting = async (id) => {\r\n  saving.value = id;\r\n  const { error } = await supabase.from('settings').upsert({ \r\n    id: id,\r\n    content: settings[id] || '',\r\n    updated_at: new Date().toISOString()\r\n  });\r\n\r\n  if (!error) {\r\n    alert(`Pengaturan ${id} berhasil disimpan!`);\r\n  }\r\n  saving.value = null;\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.main-admin-content {\r\n  margin-left: 280px;\r\n  min-height: 100vh;\r\n}\r\n\r\n.icon-box {\r\n  width: 40px;\r\n  height: 40px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n@media (max-width: 991.98px) {\r\n  .main-admin-content {\r\n    margin-left: 0;\r\n  }\r\n}\r\n</style>\r\n"],"version":3}